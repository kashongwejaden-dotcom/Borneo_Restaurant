// ─────────────────────────────────────────────────────────────────────────────
//  EatLocal OS — Prisma schema (PostgreSQL)
//  The in-browser demo store in src/lib/store.ts mirrors these models 1:1,
//  so migrating from the demo to a real backend is a drop-in change.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  COMPLETED
}

enum OrderChannel {
  PICKUP
  DELIVERY
}

enum ReservationStatus {
  UPCOMING
  SEATED
  CANCELLED
}

enum DietaryTag {
  V
  VG
  GF
  SPICY
}

// NextAuth credentials + Google OAuth accounts/sessions
model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  emailVerified  DateTime?
  passwordHash   String?       // null when the user signs up via Google OAuth
  role           Role          @default(CUSTOMER)
  image          String?
  accounts       Account[]
  sessions       Session[]
  orders         Order[]
  reservations   Reservation[]
  restaurant     Restaurant?   // set when role = ADMIN
  createdAt      DateTime      @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String  // "google" | "credentials"
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Restaurant {
  id                   String          @id @default(cuid())
  name                 String          // "Borneo Indonesian Restaurant"
  slug                 String          @unique // "borneo-kigali"
  owner                User            @relation(fields: [ownerId], references: [id])
  ownerId              String          @unique
  address              String
  phone                String
  hours                String
  // Stripe Connect — funds route directly here; EatLocal never takes a cut
  stripeAccountId      String          @unique
  acceptingOrders      Boolean         @default(true)
  categories           Category[]
  orders               Order[]
  reservations         Reservation[]
  promotions           Promotion[]
  inventory            InventoryItem[]
  createdAt            DateTime        @default(now())
}

model Category {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  name         String     // "Pembuka", "Utama"…
  note         String?
  position     Int        @default(0)
  items        MenuItem[]
}

model MenuItem {
  id           String          @id @default(cuid())
  category     Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId   String
  name         String
  description  String          @db.Text
  price        Int             // stored in cents (RWF has no decimals)
  imageUrl     String          // Cloudinary URL
  tags         DietaryTag[]
  available    Boolean         @default(true) // the "86" switch
  position     Int             @default(0)
  modifiers    ModifierGroup[]
  inventory    InventoryItem?
  orderLines   OrderLine[]
}

model ModifierGroup {
  id       String           @id @default(cuid())
  item     MenuItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId   String
  name     String           // "Spice level", "Add-ons"
  type     String           // "single" | "multi"
  position Int              @default(0)
  options  ModifierOption[]
}

model ModifierOption {
  id    String        @id @default(cuid())
  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String
  name  String
  price Int           @default(0)
}

model Order {
  id           String       @id @default(cuid())
  code         String       @unique // "BR-1047" — printed on the kitchen ticket
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  restaurantId String
  customer     User?        @relation(fields: [customerId], references: [id])
  customerId   String?      // null = guest checkout
  guestName    String?
  guestPhone   String?
  channel      OrderChannel @default(PICKUP)
  address      String?
  notes        String?      @db.Text
  lines        OrderLine[]
  subtotal     Int
  discount     Int          @default(0)
  platformFee  Int          @default(0) // always 0 — commission-free by contract
  deliveryFee  Int          @default(0)
  tip          Int          @default(0) // 100% to staff
  total        Int
  status       OrderStatus  @default(NEW)
  payment      String       // "card" | "applepay" | "googlepay"
  stripePaymentIntentId String? @unique
  promoName    String?
  placedAt     DateTime     @default(now())
  eta          DateTime
}

model OrderLine {
  id       String   @id @default(cuid())
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId  String
  item     MenuItem @relation(fields: [itemId], references: [id])
  itemId   String
  name     String   // denormalized snapshot — menu edits never rewrite history
  qty      Int
  price    Int
  modifiers Json    @default("[]") // [{name, price}]
}

model Reservation {
  id           String            @id @default(cuid())
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  user         User?             @relation(fields: [userId], references: [id])
  userId       String?
  name         String
  phone        String
  party        Int
  date         DateTime          @db.Date
  time         String            // "19:30"
  requests     String?           @db.Text
  status       ReservationStatus @default(UPCOMING)
  createdAt    DateTime          @default(now())

  @@index([restaurantId, date])
}

model Promotion {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  name         String     // "Happy Hour"
  percent      Int        // 20 = 20% off
  start        DateTime
  end          DateTime
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
}

model InventoryItem {
  id         String    @id @default(cuid())
  item       MenuItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     String    @unique
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  stock      Int       @default(0)
  lowStockAt Int       @default(10) // alert threshold
  updatedAt  DateTime  @updatedAt
}
