# ── EatLocal OS · environment template ─────────────────────────────
# Copy to .env and fill in. Never commit real secrets.

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eatlocal?schema=public"

# NextAuth.js (credentials + Google OAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxx"

# Stripe Connect — funds route directly to the restaurant's account.
# EatLocal only orchestrates the transaction; platform fee is 0 by design.
STRIPE_SECRET_KEY="sk_test_xxxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxx"

# Resend + React-Email (order confirmations, reservation reminders)
RESEND_API_KEY="re_xxxx"
EMAIL_FROM="Borneo Indonesian Restaurant <orders@eatlocal.os>"

# Cloudinary (menu image uploads in the Menu Builder)
CLOUDINARY_CLOUD_NAME="xxxx"
CLOUDINARY_API_KEY="xxxx"
CLOUDINARY_API_SECRET="xxxx"

# Realtime order channel (SSE fan-out to the dashboard)
REDIS_URL="redis://localhost:6379"
